{
  "name": "agent-daemon",
  "version": "2.1.1",
  "description": "Self-improving memory + skills runtime for AI coding agents",
  "type": "module",
  "bin": {
    "agent-daemon": "./src/cli.mjs",
    "ad": "./src/cli.mjs",
    "agent-daemon-memory-mcp": "./src/mcp/memory-server.mjs"
  },
  "main": "./src/cli.mjs",
  "exports": {
    ".": "./src/cli.mjs",
