{
  "name": "agent-daemon",
  "version": "3.0.0",
  "description": "A terminal coding agent that remembers, plus memory, guards and skills for Claude Code.",
  "type": "module",
  "bin": {
    "agent-daemon": "./src/cli.mjs",
    "ad": "./src/cli.mjs",
    "agent-daemon-memory-mcp": "./src/mcp/memory-server.mjs"
  },
  "main": "./src/cli.mjs",
  "exports": {
    ".": "./src/cli.mjs",
    "./adapters/claude-code": "./src/adapters/claude-code.mjs",
    "./digest/triage": "./src/digest/triage.mjs"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node --check src/**/*.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "lint:brand": "node scripts/check-brand.mjs --strict",
    "sync:constitution": "node scripts/sync-constitution-to-cursor.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@openai/codex": "0.164.0",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^4.0.1",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.0"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "ai-agent",
    "coding-agent",
    "memory",
    "self-improving",
    "skills"
  ],
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0"
  }
}
