  "license": "MIT",
  "keywords": [
    "claude-code",
    "ai-agent",
    "memory",
    "self-improving",
    "skills"
  ],
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0"
  }
