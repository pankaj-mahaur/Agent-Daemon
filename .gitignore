coverage/
.nyc_output/
*.tgz
*.sqlite
*.sqlite3
*.db
# Keys and certificates
*.pem
*.key
*.p12

# Vendored upstream repos: keep MANIFEST + fetch script, ignore the clone itself
vendored/*
!vendored/MANIFEST.md
!vendored/fetch.mjs
!vendored/.gitkeep

